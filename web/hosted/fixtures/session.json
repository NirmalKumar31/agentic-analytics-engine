  "metrics": [
    {
      "description": "Revenue divided by distinct orders.",
      "expression": "SUM(quantity * unit_price) / NULLIF(COUNT(DISTINCT order_id), 0)",
      "format": "currency",
      "name": "average_order_value",
      "time_field": "order_date",
      "valid_dimensions": [
        "acquisition_channel",
        "brand",
        "category",
        "customer_segment",
        "is_first_order",
        "order_channel",
        "region",
        "return_reason",
        "status"
      ]
    },
    {
      "description": "Mean days from ship to delivery.",
      "expression": "AVG(delivery_days)",
      "format": "number",
      "name": "avg_delivery_days",
      "time_field": "shipped_date",
      "valid_dimensions": [
        "acquisition_channel",
        "carrier",
        "customer_segment",
        "region"
      ]
    },
    {
      "description": "Discount as a share of list price value.",
      "expression": "100.0 * SUM(discount_amount) / NULLIF(SUM(quantity * list_price), 0)",
      "format": "percent",
      "name": "avg_discount_rate",
      "time_field": "order_date",
      "valid_dimensions": [
        "acquisition_channel",
        "brand",
        "category",
        "customer_segment",
        "is_first_order",
        "order_channel",
        "region",
        "return_reason",
        "status"
      ]
    },
    {
      "description": "Cost of goods sold.",
      "expression": "SUM(quantity * unit_cost)",
      "format": "currency",
      "name": "cogs",
      "time_field": "order_date",
      "valid_dimensions": [
        "acquisition_channel",
        "brand",
        "category",
        "customer_segment",
        "is_first_order",
        "order_channel",
        "region",
        "return_reason",
        "status"
      ]
    },
    {
      "description": "Gross profit less shipping cost, refunds and marketing spend. This is the channel profitability measure; gross margin alone ignores what a channel costs to acquire and to serve.",
      "expression": "SUM(revenue) - SUM(cogs) - SUM(shipping_cost) - SUM(refund_amount) - SUM(spend)",
      "format": "currency",
      "name": "contribution_margin",
      "time_field": "date",
      "valid_dimensions": [
        "acquisition_channel"
      ]
    },
    {
      "description": "Contribution margin as a percentage of revenue.",
      "expression": "100.0 * (SUM(revenue) - SUM(cogs) - SUM(shipping_cost) - SUM(refund_amount) - SUM(spend)) / NULLIF(SUM(revenue), 0)",
      "format": "percent",
      "name": "contribution_margin_pct",
      "time_field": "date",
      "valid_dimensions": [
        "acquisition_channel"
      ]
    },
    {
      "description": "Distinct customers who placed an order.",
      "expression": "COUNT(DISTINCT customer_id)",
      "format": "integer",
      "name": "customer_count",
      "time_field": "order_date",
      "valid_dimensions": [
        "acquisition_channel",
        "brand",
        "category",
        "customer_segment",
        "is_first_order",
        "order_channel",
        "region",
        "return_reason",
        "status"
      ]
    },
    {
      "description": "Total money given away as discount against list price.",
      "expression": "SUM(discount_amount)",
      "format": "currency",
      "name": "discount_amount",
      "time_field": "order_date",
      "valid_dimensions": [
        "acquisition_channel",
        "brand",
        "category",
        "customer_segment",
        "is_first_order",
        "order_channel",
        "region",
        "return_reason",
        "status"
      ]
    },
    {
      "description": "Gross profit as a percentage of revenue. A ratio of sums, never an average of per-row margins.",
      "expression": "100.0 * (SUM(quantity * unit_price) - SUM(quantity * unit_cost)) / NULLIF(SUM(quantity * unit_price), 0)",
      "format": "percent",
      "name": "gross_margin_pct",
      "time_field": "order_date",
      "valid_dimensions": [
        "acquisition_channel",
        "brand",
        "category",
        "customer_segment",
        "is_first_order",
        "order_channel",
        "region",
        "return_reason",
        "status"
      ]
    },
    {
      "description": "Revenue minus cost of goods sold.",
      "expression": "SUM(quantity * unit_price) - SUM(quantity * unit_cost)",
      "format": "currency",
      "name": "gross_profit",
      "time_field": "order_date",
      "valid_dimensions": [
        "acquisition_channel",
        "brand",
        "category",
        "customer_segment",
        "is_first_order",
        "order_channel",
        "region",
        "return_reason",
        "status"
      ]
    },
    {
      "description": "Share of shipments delivered later than promised.",
      "expression": "100.0 * SUM(is_late_int) / NULLIF(COUNT(*), 0)",
      "format": "percent",
      "name": "late_delivery_rate",
      "time_field": "shipped_date",
      "valid_dimensions": [
        "acquisition_channel",
        "carrier",
        "customer_segment",
        "region"
      ]
    },
    {
      "description": "Paid marketing spend.",
      "expression": "SUM(spend)",
      "format": "currency",
      "name": "marketing_spend",
      "time_field": "date",
      "valid_dimensions": [
        "acquisition_channel"
      ]
    },
    {
      "description": "Distinct order count.",
      "expression": "COUNT(DISTINCT order_id)",
      "format": "integer",
      "name": "orders",
      "time_field": "order_date",
      "valid_dimensions": [
        "acquisition_channel",

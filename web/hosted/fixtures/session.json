        "status"
      ]
    },
    {
      "description": "Share of customers with more than one order.",
      "expression": "100.0 * SUM(is_repeat) / NULLIF(COUNT(*), 0)",
      "format": "percent",
      "name": "repeat_purchase_rate",
      "time_field": "signup_date",

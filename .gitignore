.venv/
__pycache__/
*.pyc
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.DS_Store
# Anywhere, not only under web/: a stray `npx --prefix` leaves a vitest
# cache in a root `node_modules/`, which is not something to commit.
node_modules/
web/dist/
*.tsbuildinfo
# Generated demo warehouse and per-session scratch databases.
var/
.env

# Playwright
web/test-results/
web/playwright-ledger/
web/playwright-report/
# One report per engine: the three used to overwrite one another.
web/playwright-results-*.json
web/playwright-results.json
web/blob-report/
web/.playwright/
# Hosted visual acceptance output: screenshots, traces and the run's own
# machine-readable report. Evidence about one deployment at one moment, not
# something the repository should carry.
web/hosted-results/

# Local Claude Code settings. Machine-specific and not part of the project.
.claude/

# Rasterised design sheets. `docs/design/generators/render.mjs` writes these
# beside the committed SVGs they come from; the SVG is the source and the
# audit reads it. The architecture atlas PNGs are an exception and are
# tracked, because its README embeds them.
docs/design/*.png
docs/design/mockups/*.png
docs/design/wireframes/*.png

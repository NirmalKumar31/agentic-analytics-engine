# Every setting below has a working default. The project runs with this file
# absent: the default provider is a deterministic scripted stand-in, so no
# credential is required for tests, CI, the demo data, the recorded runs or
# the frontend.

# ---------------------------------------------------------------- provider
# fake  - deterministic scripted provider (default; no credential)
# local - an Ollama-compatible server on AAE_OLLAMA_BASE_URL
# cloud - a hosted API; requires AAE_CLOUD_API_KEY
AAE_PROVIDER_MODE=fake

AAE_OLLAMA_BASE_URL=http://127.0.0.1:11434
AAE_OLLAMA_MODEL=qwen2.5:7b-instruct

# Only read when AAE_PROVIDER_MODE=cloud. Never commit a real value.
# AAE_CLOUD_API_KEY=
AAE_CLOUD_MODEL=claude-sonnet-5
AAE_CLOUD_BASE_URL=https://api.anthropic.com
# Ceiling on one model call, enforced by the application and not only by the
# HTTP client. A connection that is accepted and then goes silent will not
# trip a read timeout, so without this an agent loop can block indefinitely.
AAE_CLOUD_TIMEOUT_SECONDS=120
AAE_OLLAMA_TIMEOUT_SECONDS=300

# ------------------------------------------------------------------- modes
# When false the server serves recorded runs only and refuses to start a new
# analysis. This is the safe posture for a public deployment.
AAE_LIVE_ANALYTICS_ENABLED=false
AAE_UPLOADS_ENABLED=true

# Whether an uploaded dataset's individual cells may be shown to a *remote*
# model. Off by default; schema, profile and aggregates still go. Ignored
# unless AAE_PROVIDER_MODE=cloud, because nothing leaves the machine
# otherwise.
AAE_ALLOW_UPLOAD_ROW_DISCLOSURE=false

# ----------------------------------------------------------------- budgets
# Nested settings use a double underscore.
AAE_BUDGETS__MAX_ANALYSIS_TASKS=6
AAE_BUDGETS__MAX_TOOL_CALLS_PER_TASK=6
AAE_BUDGETS__MAX_TOTAL_TOOL_CALLS=48
AAE_BUDGETS__MAX_LLM_CALLS=40
AAE_BUDGETS__MAX_RUNTIME_SECONDS=300
AAE_BUDGETS__MAX_RESULT_ROWS=500
AAE_BUDGETS__MAX_SAMPLE_ROWS=20
AAE_BUDGETS__QUERY_TIMEOUT_SECONDS=20
AAE_BUDGETS__MAX_UPLOAD_BYTES=26214400
# Declared uncompressed size in a Parquet footer, refused before any
# value is decoded. Default 2 GB; the public deployment sets 512 MB.
AAE_BUDGETS__MAX_PARQUET_UNCOMPRESSED_BYTES=2147483648

# --------------------------------------------------------------------- MCP
# Comma-separated Host header allow-list for the Streamable HTTP /mcp
# endpoint. Empty on a network binding means the endpoint is *withdrawn*
# (503) rather than served without Host validation. The application is
# unaffected either way: its agents reach the same MCP server over the SDK's
# in-process transport.
AAE_MCP_ALLOWED_HOSTS=
# Where the server binds. Loopback is treated as local development.
AAE_BIND_HOST=127.0.0.1

# ------------------------------------------------------------------ server
AAE_LOG_LEVEL=INFO
AAE_LOG_JSON=true
AAE_SESSION_TTL_SECONDS=3600
AAE_MAX_CONCURRENT_SESSIONS=32
# How often expired sessions are swept. Expiry is on a clock, not on the
# next request, so an abandoned upload does not stay resident.
AAE_SESSION_SWEEP_SECONDS=45

# Mark the session capability cookie Secure. Must be true behind TLS; a
# TLS-terminating proxy forwards plain HTTP, so this cannot be inferred from
# the request. False for local development over http://127.0.0.1.
AAE_SESSION_COOKIE_SECURE=false

# --------------------------------------------------------- engine resources
# The DuckDB envelope given to every session. Multiply by the number of
# sessions admitted and compare against the instance before raising either.
AAE_DUCKDB_MEMORY_LIMIT=1GB
AAE_DUCKDB_THREADS=2
